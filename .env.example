# ==============================================================================
# ALFA SALGADOS DELIVERY — EXEMPLO DE CONFIGURAÇÃO (.env)
# Copie para .env e ajuste os valores conforme seu ambiente.
# NUNCA salve credenciais reais ou senhas no controle de versão.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR E REDE
# ------------------------------------------------------------------------------
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# Em produção (Cloud Run / Firebase Hosting):
# NODE_ENV=production
# PUBLIC_URL=https://delivery.alfasalgados.com.br
# HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. AUTENTICAÇÃO DO ADMINISTRADOR
# Crie as credenciais locais com: npm run setup
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@alfasalgados.com.br
ADMIN_PASSWORD_HASH=

# ------------------------------------------------------------------------------
# 3. PERSISTÊNCIA DE DADOS (SQLITE LOCAL vs SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
# Modo padrão para desenvolvimento local no Windows:
DATABASE_TYPE=sqlite
ALFA_DATABASE=./data/alfa.sqlite

# Para produção com Supabase PostgreSQL:
# Descomente e preencha as variáveis abaixo:
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 4. SUPABASE AUTH & STORAGE (OPCIONAL / PRODUÇÃO)
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://[SEU-PROJETO].supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=images
